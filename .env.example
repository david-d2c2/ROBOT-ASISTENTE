# Copia como .env solo si no existe. Nunca publiques tus claves.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Alternativa Z.AI (GLM): cambia AI_PROVIDER a zai.
# ZAI_BASE_URL por defecto: https://api.z.ai/api/paas/v4/
# (planes de código: ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4/)
ZAI_API_KEY=
ZAI_MODEL=glm-4.6

# Memoria de conversación: número de turnos (pregunta+respuesta) recordados.
CHAT_HISTORY_TURNS=8

# Personalidad del robot: acido (por defecto) | normal | tecnico
PERSONA=acido

# Atajo global de dictado (push-to-talk), vacío para desactivarlo.
HOTKEY=Ctrl+Alt+R

# Animaciones reducidas (útil para pantallas sensibles): 1 para activar.
REDUCED_MOTION=0

# Voz sintetizada: edge (Internet) | piper (local, sin conexión; instala
# primero: pip install -r requirements-tts.txt). El modelo de Piper se
# descarga solo la primera vez (~65 MB).
TTS_PROVIDER=edge
TTS_VOICE=es-ES-ElviraNeural
PIPER_VOICE=es_ES-davefx-medium
TTS_RATE=+8%
TTS_PITCH=+18Hz

# Dictado: google (por defecto, envía audio a Google) o whisper (local, sin
# conexión; instala antes: pip install -r requirements-whisper.txt)
STT_PROVIDER=google
STT_LANGUAGE=es-ES
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# Alternativa Gemini: cambia AI_PROVIDER a gemini.
GEMINI_API_KEY=
# Obligatorio: identifica un modelo disponible en tu cuenta de Gemini.
GEMINI_MODEL=REEMPLAZAR_POR_MODELO_DISPONIBLE

# Alternativa local: AI_PROVIDER=ollama
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3.2

# AI_PROVIDER=lmstudio usa http://localhost:1234/v1/chat/completions
# AI_PROVIDER=llamacpp para servidores llama.cpp compatibles con OpenAI, por ejemplo:
# AI_PROVIDER=llamacpp
# LOCAL_CHAT_URL=http://127.0.0.1:8080/v1/chat/completions
# LOCAL_LLM_MODEL=mi-modelo.gguf
